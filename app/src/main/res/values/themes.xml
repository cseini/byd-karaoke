<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Karaoke" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/tj_pink</item>
        <item name="colorOnPrimary">@color/tj_text_primary</item>
        <item name="colorSecondary">@color/tj_cyan</item>
        <item name="colorOnSecondary">@color/tj_bg_deep</item>
        <item name="colorSurface">@color/tj_panel</item>
        <item name="colorOnSurface">@color/tj_text_primary</item>
        <item name="colorSurfaceVariant">@color/tj_panel_light</item>
        <item name="android:windowBackground">@color/tj_bg</item>
        <item name="android:statusBarColor">@color/tj_bg_deep</item>
        <item name="android:navigationBarColor">@color/tj_bg_deep</item>
        <item name="android:textColorPrimary">@color/tj_text_primary</item>
        <item name="android:textColorSecondary">@color/tj_text_secondary</item>
        <item name="android:textColorHint">@color/tj_text_hint</item>
        <item name="materialButtonStyle">@style/Widget.Karaoke.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Karaoke.Button.Outlined</item>
        <item name="editTextStyle">@style/Widget.Karaoke.EditText</item>
        <item name="android:editTextStyle" tools:targetApi="21">@style/Widget.Karaoke.EditText</item>
    </style>

    <style name="Widget.Karaoke.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/tj_pink</item>
        <item name="android:textColor">@color/tj_text_primary</item>
    </style>

    <style name="Widget.Karaoke.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/tj_cyan</item>
        <item name="android:textColor">@color/tj_cyan</item>
    </style>

    <style name="Widget.Karaoke.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_search_field</item>
        <item name="android:textColor">@color/tj_text_primary</item>
        <item name="android:textColorHint">@color/tj_text_hint</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

</resources>
