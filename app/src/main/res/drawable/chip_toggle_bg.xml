<?xml version="1.0" encoding="utf-8"?>
<!-- 텍스트 칩 토글(자동숨김) 배경 — selected(켜짐)면 골드 톤, 아니면 기본 유리 톤. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#3DE8C468" />
            <stroke android:width="1dp" android:color="@color/tj_gold_deep" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@color/glass_card" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
