<?xml version="1.0" encoding="utf-8"?>
<!-- 진행바 손잡이 — 골드 원 + 은은한 후광(글로우) 느낌의 겹쳐진 반투명 링. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="18dp" android:height="18dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#33E8C468" />
        </shape>
    </item>
    <item android:width="11dp" android:height="11dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/tj_gold" />
        </shape>
    </item>
</layer-list>
