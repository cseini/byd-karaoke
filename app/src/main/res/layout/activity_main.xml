<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tj_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="노래방"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/tj_text_primary" />

            <TextView
                android:id="@+id/header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘도 한 곡 어때요?"
                android:textSize="13sp"
                android:textColor="@color/tj_text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_reserve_server"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 예약서버" />
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/divider_gradient" />

    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="노래 제목·가수로 검색"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:textSize="18sp"
            android:textColor="@color/tj_text_secondary"
            android:visibility="gone"
            android:text="✕" />

        <Button
            android:id="@+id/btn_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:backgroundTint="@color/tj_blue"
            android:text="🎙 음성" />

        <CheckBox
            android:id="@+id/chk_autoplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="13sp"
            android:textColor="@color/tj_text_secondary"
            android:visibility="gone"
            android:text="첫 곡 자동" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/tj_text_secondary"
        android:text="" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 좌: 최근 부른 노래 / 우: 예약 대기열(플레이어 화면과 같은 배치, 예약 있을 때만) -->
        <LinearLayout
            android:id="@+id/history_section"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="🕘 최근 부른 노래"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_cyan" />

                <TextView
                    android:id="@+id/history_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="24dp"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@color/tj_text_secondary"
                    android:visibility="gone"
                    android:text="아직 부른 노래가 없습니다.\n검색해서 첫 곡을 불러보세요." />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/history"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_queue_section"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@color/tj_panel"
                android:padding="8dp">

                <TextView
                    android:id="@+id/home_queue_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="🎫 예약된 곡"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_gold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_queue"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/include_navbar" />
</LinearLayout>

    <!-- 음성 검색 후 자동재생 카운트다운 오버레이: 좌=다시 검색 / 우=취소 -->
    <FrameLayout
        android:id="@+id/autoplay_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050510"
        android:visibility="gone">

        <!-- 두 개의 큰 탭 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/autoplay_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="#1A00E5FF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙"
                    android:textSize="60sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="다시 검색"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_cyan" />
            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:id="@+id/autoplay_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="#1AFF3B30">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textSize="60sp"
                    android:textColor="@color/tj_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="취소"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_red" />
            </LinearLayout>
        </LinearLayout>

        <!-- 곡 제목 + 카운트 (탭은 아래 영역으로 통과)
             Kinex 미디어 위젯의 상단 중앙 '…' 오버레이 버튼에 가리지 않도록 아래로 내림 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="76dp"
            android:paddingHorizontal="24dp"
            android:duplicateParentState="false"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/autoplay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="#CC12122A"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:text="곡 제목"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/tj_gold"
                android:shadowColor="@color/tj_gold_deep"
                android:shadowRadius="20"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/autoplay_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="5"
                android:textSize="96sp"
                android:textStyle="bold"
                android:textColor="@color/tj_gold"
                android:shadowColor="@color/tj_gold_deep"
                android:shadowRadius="24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="곧 자동으로 재생됩니다"
                android:textSize="16sp"
                android:textColor="@color/tj_text_secondary" />
        </LinearLayout>
    </FrameLayout>

    <!-- 음성 인식 플로팅 오버레이 -->
    <FrameLayout
        android:id="@+id/voice_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050510"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/voice_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙"
                android:textSize="110sp" />

            <TextView
                android:id="@+id/voice_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="말씀하세요"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:shadowColor="@color/tj_cyan"
                android:shadowRadius="18" />

            <TextView
                android:id="@+id/voice_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="노래 제목이나 가수를 말하면 검색해요"
                android:textSize="15sp"
                android:textColor="@color/tj_text_secondary" />

            <!-- 마이크 입력 레벨 미터: 소리가 들어오면 채워진다 -->
            <ProgressBar
                android:id="@+id/voice_level"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="260dp"
                android:layout_height="14dp"
                android:layout_marginTop="20dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/tj_cyan"
                android:visibility="gone" />

            <TextView
                android:id="@+id/voice_level_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="🎤 마이크 입력 대기…"
                android:textSize="13sp"
                android:textColor="@color/tj_text_hint"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- (테스트 앱 전용) 메인 화면 안에서 재생 — 분할화면 유지용 임베드 플레이어 -->
    <FrameLayout
        android:id="@+id/embed_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tj_bg_deep"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/embed_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <!-- 예약된 곡(옆 상시 노출) -->
                <LinearLayout
                    android:id="@+id/embed_queue_side"
                    android:layout_width="220dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@color/tj_panel"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        android:text="🎫 예약된 곡"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/tj_cyan" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/embed_queue_list"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/embed_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/tj_bg"
                android:padding="12dp">

                <TextView
                    android:id="@+id/embed_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="재생 중" />

                <TextView
                    android:id="@+id/embed_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_red"
                    android:paddingTop="4dp"
                    android:text="대기 중" />

                <!-- 재생 위치 seek 바 -->
                <LinearLayout
                    android:id="@+id/embed_seek_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp">

                    <SeekBar
                        android:id="@+id/embed_seek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/embed_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minWidth="82dp"
                        android:gravity="end"
                        android:textSize="12sp"
                        android:textColor="@color/tj_cyan"
                        android:text="0:00 / 0:00" />
                </LinearLayout>

                <!-- 다시듣기 컨트롤(채점 후 등장) -->
                <LinearLayout
                    android:id="@+id/embed_replay_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:visibility="gone">

                    <SeekBar
                        android:id="@+id/embed_replay_seek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/embed_replay_play"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:layout_marginStart="8dp"
                        app:backgroundTint="@color/tj_blue"
                        android:text="⏸ 정지" />
                </LinearLayout>

                <!-- 키(반음)·속도 조절 -->
                <LinearLayout
                    android:id="@+id/embed_tune_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/tj_text_secondary"
                        android:text="키" />

                    <Button
                        android:id="@+id/embed_key_down"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="14dp"
                        android:text="−" />

                    <TextView
                        android:id="@+id/embed_key_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="34dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tj_cyan"
                        android:text="0" />

                    <Button
                        android:id="@+id/embed_key_up"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="+" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:textSize="13sp"
                        android:textColor="@color/tj_text_secondary"
                        android:text="속도" />

                    <Button
                        android:id="@+id/embed_speed_down"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="14dp"
                        android:text="−" />

                    <TextView
                        android:id="@+id/embed_speed_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="52dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tj_cyan"
                        android:text="1.0x" />

                    <Button
                        android:id="@+id/embed_speed_up"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="+" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/embed_tune_reset"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:textSize="12sp"
                        android:textColor="@color/tj_text_secondary"
                        android:text="원래대로" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <Button
                        android:id="@+id/embed_stop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:backgroundTint="@color/tj_red"
                        android:text="⏹ 종료" />

                    <Button
                        android:id="@+id/embed_retry"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:backgroundTint="@color/tj_orange"
                        android:text="다시" />

                    <Button
                        android:id="@+id/embed_replay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:visibility="gone"
                        app:backgroundTint="@color/tj_cyan"
                        android:textColor="@color/tj_bg_deep"
                        android:text="다시듣기" />

                    <Button
                        android:id="@+id/embed_next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:visibility="gone"
                        app:backgroundTint="@color/tj_pink"
                        android:text="다음곡" />

                    <Button
                        android:id="@+id/embed_close"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="닫기" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 전체화면 토글(영상 좌상단) -->
        <Button
            android:id="@+id/embed_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textSize="16sp"
            android:background="#66000000"
            android:textColor="#FFFFFF"
            android:text="⛶" />

        <View
            android:id="@+id/embed_fullscreen_tap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- 점수 화면(채점 후) — 빈 곳 탭하면 검색으로 -->
        <FrameLayout
            android:id="@+id/embed_score"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2050510"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ 오늘의 점수 ✨"
                    android:textSize="20sp"
                    android:textColor="@color/tj_cyan" />

                <TextView
                    android:id="@+id/embed_score_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="110sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_gold"
                    android:shadowColor="@color/tj_gold_deep"
                    android:shadowRadius="22" />

                <TextView
                    android:id="@+id/embed_score_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_pink" />

                <TextView
                    android:id="@+id/embed_score_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:textSize="18sp"
                    android:textColor="@color/tj_text_secondary"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="18dp">

                    <Button
                        android:id="@+id/embed_score_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/tj_orange"
                        android:text="다시 부르기" />

                    <Button
                        android:id="@+id/embed_score_replay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:backgroundTint="@color/tj_cyan"
                        android:textColor="@color/tj_bg_deep"
                        android:text="다시듣기" />

                    <Button
                        android:id="@+id/embed_score_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:visibility="gone"
                        app:backgroundTint="@color/tj_pink"
                        android:text="다음곡 ▶" />
                </LinearLayout>

                <!-- 자동 넘김 카운트다운(채점 화면에서도 보이도록) -->
                <TextView
                    android:id="@+id/embed_score_next_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="14dp"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/tj_gold"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:text="(빈 곳을 누르면 검색으로 돌아갑니다)"
                    android:textSize="12sp"
                    android:textColor="@color/tj_text_hint" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- (테스트 앱 전용) 녹음함/랭킹/설정을 메인 화면 안에 띄우는 오버레이 — 분할화면 유지용 -->
    <FrameLayout
        android:id="@+id/embed_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tj_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
