<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tj_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤 BYD YT노래방"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tj_pink"
            android:shadowColor="@color/tj_pink_dark"
            android:shadowRadius="16"
            android:shadowDx="0"
            android:shadowDy="0" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/divider_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="노래 제목·가수로 검색"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:backgroundTint="@color/tj_blue"
            android:text="🎙 음성" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:backgroundTint="@color/tj_cyan"
            android:textColor="@color/tj_bg_deep"
            android:text="검색" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textColor="@color/tj_text_secondary"
        android:text="검색어를 입력하거나 음성 버튼을 누르세요." />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/history_section"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="🕘 최근 부른 노래"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan" />

            <TextView
                android:id="@+id/history_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/tj_text_secondary"
                android:visibility="gone"
                android:text="아직 부른 노래가 없습니다.\n검색해서 첫 곡을 불러보세요." />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/include_navbar" />
</LinearLayout>

    <!-- 음성 인식 플로팅 오버레이 -->
    <FrameLayout
        android:id="@+id/voice_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050510"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/voice_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙"
                android:textSize="110sp" />

            <TextView
                android:id="@+id/voice_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="말씀하세요"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:shadowColor="@color/tj_cyan"
                android:shadowRadius="18" />

            <TextView
                android:id="@+id/voice_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="노래 제목이나 가수를 말하면 검색해요"
                android:textSize="15sp"
                android:textColor="@color/tj_text_secondary" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
