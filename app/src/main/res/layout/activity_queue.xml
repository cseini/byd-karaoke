<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tj_bg"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎫 예약 대기열"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/tj_cyan"
        android:shadowColor="@color/tj_cyan"
        android:shadowRadius="12"
        android:paddingBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/divider_gradient" />

    <TextView
        android:id="@+id/queue_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="예약된 곡이 없습니다."
        android:textSize="14sp"
        android:textColor="@color/tj_text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/queue_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btn_play_first"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:backgroundTint="@color/tj_green"
            android:textColor="@color/tj_bg_deep"
            android:text="첫 곡부터 부르기" />

        <Button
            android:id="@+id/btn_clear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="전체 삭제" />
    </LinearLayout>

    <include layout="@layout/include_navbar" />
</LinearLayout>
