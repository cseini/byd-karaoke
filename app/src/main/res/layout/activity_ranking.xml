<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tj_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏆 역대 랭킹"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tj_gold"
            android:shadowColor="@color/tj_gold_deep"
            android:shadowRadius="14" />

        <Button
            android:id="@+id/btn_back"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닫기" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/divider_gradient" />

    <TextView
        android:id="@+id/ranking_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/tj_text_secondary"
        android:visibility="gone"
        android:text="아직 채점된 곡이 없습니다.\n노래를 부르면 랭킹에 오릅니다." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ranking_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp" />

    <include layout="@layout/include_navbar" />
</LinearLayout>
