<?xml version="1.0" encoding="utf-8"?>
<!-- 일반 유튜브 검색 결과 카드(썸네일 + 제목). 히스토리 타일처럼 그리드로 배치된다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:layout_margin="5dp"
    android:padding="8dp">

    <ImageView
        android:id="@+id/result_thumb"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:scaleType="centerCrop"
        android:background="#22000000"
        android:contentDescription="썸네일" />

    <TextView
        android:id="@+id/result_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/tj_text_primary"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="제목" />

    <TextView
        android:id="@+id/result_channel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/tj_text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="채널" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_reserve"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="예약" />

        <Button
            android:id="@+id/btn_play_now"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="재생" />
    </LinearLayout>
</LinearLayout>
