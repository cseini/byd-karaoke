<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/tj_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱 폰으로 예약하기"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/tj_cyan" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="@color/tj_text_secondary"
        android:text="휴대폰 핫스팟에 차와 승객 폰을 모두 연결한 뒤\n아래 QR을 폰 카메라로 찍으면 검색·예약할 수 있어요." />

    <ImageView
        android:id="@+id/reserve_qr"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:contentDescription="QR" />

    <TextView
        android:id="@+id/reserve_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:textSize="14sp"
        android:textColor="@color/tj_gold"
        android:fontFamily="monospace"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/reserve_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="@color/tj_text_hint"
        android:text="예약된 곡은 재생 화면에서 확인·관리할 수 있어요." />
</LinearLayout>
