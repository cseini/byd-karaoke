<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tj_bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/player_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tj_bg"
            android:padding="14dp">

            <TextView
                android:id="@+id/song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/tj_text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="재생 중" />

            <TextView
                android:id="@+id/rec_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tj_red"
                android:paddingTop="4dp"
                android:text="대기 중" />

            <!-- 다시듣기 컨트롤: 시크바(드래그로 영상·녹음 동시 이동) + 재생/정지 -->
            <LinearLayout
                android:id="@+id/replay_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/replay_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/replay_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:textColor="@color/tj_cyan"
                        android:text="0:00 / 0:00" />

                    <Button
                        android:id="@+id/replay_play"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="120dp"
                        app:backgroundTint="@color/tj_blue"
                        android:text="⏸ 정지" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/song_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:backgroundTint="@color/tj_red"
                    android:text="⏹ 정지" />

                <Button
                    android:id="@+id/btn_retry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:backgroundTint="@color/tj_orange"
                    android:text="다시 부르기" />

                <Button
                    android:id="@+id/btn_cancel"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="취소" />

                <Button
                    android:id="@+id/btn_next_reserved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    app:backgroundTint="@color/tj_pink"
                    android:text="🎫 예약목록" />
            </LinearLayout>
        </LinearLayout>

        <include layout="@layout/include_navbar" />
    </LinearLayout>

    <!-- 예약 목록 패널: 폰으로 예약된 곡 순서 + 부르기/취소 -->
    <LinearLayout
        android:id="@+id/reserve_queue_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F00A0A1A"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎫 예약된 곡"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/tj_pink" />

            <Button
                android:id="@+id/btn_queue_close"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="닫기" />
        </LinearLayout>

        <TextView
            android:id="@+id/queue_panel_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/tj_text_secondary"
            android:text="아직 예약된 곡이 없어요.\n승객이 폰으로 예약하면 여기에 순서대로 쌓여요." />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queue_panel_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="10dp" />
    </LinearLayout>

    <!-- 노래방식 점수 연출: 탭하면 닫힘 -->
    <FrameLayout
        android:id="@+id/score_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2050510"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/score_next_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:paddingTop="20dp"
            android:paddingHorizontal="20dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/tj_cyan"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ 오늘의 점수 ✨"
                android:textSize="22sp"
                android:textColor="@color/tj_cyan"
                android:shadowColor="@color/tj_cyan"
                android:shadowRadius="14" />

            <TextView
                android:id="@+id/score_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="130sp"
                android:textStyle="bold"
                android:textColor="@color/tj_gold"
                android:shadowColor="@color/tj_gold_deep"
                android:shadowRadius="24"
                android:shadowDx="0"
                android:shadowDy="0" />

            <TextView
                android:id="@+id/score_grade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/tj_pink"
                android:shadowColor="@color/tj_pink_dark"
                android:shadowRadius="12" />

            <TextView
                android:id="@+id/score_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textSize="13sp"
                android:textColor="@color/tj_text_secondary"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/score_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@color/tj_orange"
                    android:text="다시 부르기" />

                <Button
                    android:id="@+id/score_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:visibility="gone"
                    app:backgroundTint="@color/tj_pink"
                    android:text="다음 예약곡 ▶" />

                <Button
                    android:id="@+id/score_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    app:backgroundTint="@color/tj_blue"
                    android:text="닫기" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="18dp"
                android:text="(빈 곳을 누르면 검색으로 돌아갑니다)"
                android:textSize="12sp"
                android:textColor="@color/tj_text_hint" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
