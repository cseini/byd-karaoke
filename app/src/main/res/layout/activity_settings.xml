<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tj_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ 설정"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/tj_pink"
        android:shadowColor="@color/tj_pink_dark"
        android:shadowRadius="12" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/divider_gradient" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="검색 방식"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <CheckBox
                android:id="@+id/chk_keyless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tj_text_primary"
                android:text="API 키 없이 검색 (키 발급 불필요)" />

            <EditText
                android:id="@+id/api_key_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="YouTube Data API v3 키 (API 방식 선택 시)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/openai_key_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="OpenAI API 키 (음성검색용 · 선택)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="녹음 저장 위치"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <RadioGroup
                android:id="@+id/storage_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/st_internal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="차 내부 저장소" />

                <RadioButton
                    android:id="@+id/st_sd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="SD카드" />
            </RadioGroup>

            <TextView
                android:id="@+id/storage_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:fontFamily="monospace"
                android:text="용량 확인 중…" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="최대 사용 용량(MB):" />

                <EditText
                    android:id="@+id/max_storage_input"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:inputType="number"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/tj_text_hint"
                android:text="이 용량을 넘으면 오래된 녹음부터 자동으로 지웁니다." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="앱 업데이트"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="8dp"
                android:text="현재 버전 확인 중…" />

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/tj_green"
                android:textColor="@color/tj_bg_deep"
                android:text="🔄 업데이트 확인" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="저장" />

    <include layout="@layout/include_navbar" />
</LinearLayout>
