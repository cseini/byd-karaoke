<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/app_bg_gradient"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="설정"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tj_text_primary" />

        <Button
            android:id="@+id/btn_log_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            app:backgroundTint="@color/tj_panel_light"
            android:textColor="@color/tj_text_primary"
            android:text="로그 전송" />

        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            app:backgroundTint="@color/tj_green"
            android:textColor="@color/tj_bg_deep"
            android:text="업데이트" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="저장" />

        <Button
            android:id="@+id/btn_back"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="닫기" />
    </LinearLayout>

    <TextView
        android:id="@+id/update_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textSize="12sp"
        android:textColor="@color/tj_text_secondary"
        android:text="현재 버전 확인 중…" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <!-- ══════════ 왼쪽 컬럼 ══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 카드: 음성 검색 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎤 음성 검색"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tj_cyan"
                        android:paddingBottom="12dp" />

                    <RadioGroup
                        android:id="@+id/stt_engine_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/eng_groq"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tj_text_primary"
                            android:textSize="13sp"
                            android:text="🌐 Groq\n(키 불필요)" />

                        <RadioButton
                            android:id="@+id/eng_gemini"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tj_text_primary"
                            android:textSize="13sp"
                            android:text="Gemini\n(키 필요)" />

                        <RadioButton
                            android:id="@+id/eng_gboard"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tj_text_primary"
                            android:textSize="13sp"
                            android:text="⌨️ Gboard\n(정확·키보드)" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tj_text_hint"
                        android:paddingTop="4dp"
                        android:text="Groq: 서버 음성인식(무료·정확·빠름). ⚠️ 운영자 AI 계정 공유라 하루 약 50회 무료 한도가 있어요 — 다 쓰면 Gemini나 Gboard로 바꿔주세요. Gemini: 직접 발급한 키(한도 여유). Gboard: 구글 키보드 음성(가장 정확, 순정마이크 씨라이언에 특히). 인터넷 필요." />

                    <TextView
                        android:id="@+id/txt_car_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/tj_gold"
                        android:paddingTop="8dp"
                        android:visibility="gone"
                        android:text="" />

                    <LinearLayout
                        android:id="@+id/gboard_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btn_gboard_install"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="13sp"
                            android:text="⌨️ Gboard 설치·기본키보드로 설정 (약 80MB)" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/tj_text_hint"
                            android:paddingTop="4dp"
                            android:text="Gboard가 없으면 위 버튼으로 설치하세요(자동 다운로드·기본키보드 지정). ⚠️ 약 80MB라 회선이 느리면 몇 분 걸리고 중간에 끊길 수 있어요 — 끊겨도 버튼을 다시 누르면 받은 지점부터 이어받습니다. 음성검색 시 앱이 Gboard 마이크를 자동으로 눌러 인식합니다(접근성은 앱이 자동으로 켬)." />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/gemini_key_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btn_key_qr"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="📱 폰으로 키 입력 (QR)" />

                        <EditText
                            android:id="@+id/openai_key_input"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="Gemini API 키"
                            android:inputType="text"
                            android:importantForAutofill="no" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/tj_text_hint"
                            android:paddingTop="6dp"
                            android:text="aistudio.google.com 에서 무료 발급" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="음성인식 모델"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/tj_cyan"
                            android:paddingTop="12dp"
                            android:paddingBottom="4dp" />

                        <RadioGroup
                            android:id="@+id/gemini_model_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/gm_flash"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tj_text_primary"
                                android:textSize="13sp"
                                android:text="정확 (flash 계열)" />

                            <RadioButton
                                android:id="@+id/gm_lite"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tj_text_primary"
                                android:textSize="13sp"
                                android:text="한도↑ (flash-lite 계열)" />
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>

                <!-- 카드: USB 마이크 버튼 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <CheckBox
                        android:id="@+id/chk_mic_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tj_text_primary"
                        android:text="🎙 USB 마이크 버튼으로 제어" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tj_text_hint"
                        android:paddingStart="8dp"
                        android:text="한 번 누르기는 원래 기능 그대로. 아래 제스처에 기능을 매핑하세요.\n⚠️ 기종에 따라 안 될 수 있어요 — 기본 버튼이 이상해지면 끄세요" />

                    <CheckBox
                        android:id="@+id/chk_native_mic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/tj_text_primary"
                        android:text="🎤 순정 마이크 사용 (버튼 음성검색 시 목소리 입력)" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tj_text_hint"
                        android:paddingStart="8dp"
                        android:text="아토3 등 순정 마이크(버튼은 되는데 음성검색에 목소리가 안 들어가는 마이크)면 켜세요. 버튼 음성검색·노래 채점·녹음 때 마이크를 잠깐 놓아 목소리가 들어가게 하고, 끝나면 버튼을 다시 잡습니다.\n⚠️ 노래 부르는 중에는 버튼이 채점·녹음에 마이크를 쓰느라 동작하지 않습니다 — 버튼 기능은 검색 화면에서만 됩니다." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/tj_text_primary"
                            android:text="🎙 마이크 길게" />

                        <Spinner
                            android:id="@+id/map_mic_long"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/tj_text_primary"
                            android:text="🎙 마이크 두 번" />

                        <Spinner
                            android:id="@+id/map_mic_double"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/tj_text_primary"
                            android:text="🔊 볼륨▲ 두 번" />

                        <Spinner
                            android:id="@+id/map_vol_up2"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/tj_text_primary"
                            android:text="🔉 볼륨▼ 두 번" />

                        <Spinner
                            android:id="@+id/map_vol_down2"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btn_mic_learn"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:text="🎯 버튼 학습" />

                        <Button
                            android:id="@+id/btn_mic_diag"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="13sp"
                            android:text="🔍 진단" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/chk_wheel_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/tj_text_primary"
                        android:visibility="gone"
                        android:text="🎚 휠 무음 버튼 더블클릭으로 음성검색" />

                    <CheckBox
                        android:id="@+id/chk_google_stt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/tj_text_primary"
                        android:visibility="gone"
                        android:text="🎤 구글 키보드 음성 우선(인식률 좋음)" />

                    <TextView
                        android:id="@+id/txt_google_stt_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tj_text_hint"
                        android:paddingStart="8dp"
                        android:visibility="gone"
                        android:text="Gemini 대신 구글 키보드(Gboard) 음성입력을 씁니다 — 인식률이 좋고 API 키가 필요 없어요. Gboard가 없으면 설치를 안내합니다." />

                    <CheckBox
                        android:id="@+id/chk_sealion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/tj_text_primary"
                        android:visibility="gone"
                        android:text="🚗 씨라이언7 전용 모드" />

                    <TextView
                        android:id="@+id/txt_sealion_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tj_text_hint"
                        android:paddingStart="8dp"
                        android:visibility="gone"
                        android:text="앱이 USB 마이크 버튼을 직접 못 읽는 유닛(씨라이언7/DiLink5)용입니다.\n• 마이크·볼륨 아무 버튼이나 눌러 볼륨 조절창(BYD 팝업)이 뜨면 음성인식이 시작됩니다\n⚠️ 대신 볼륨 조절 팝업 때문에 불편할 수 있어요 — 그 버튼을 누르면 음성인식이 떠서 볼륨 조절이 방해됩니다\n※ 켜면 'USB 마이크 버튼으로 제어'는 자동 해제되고, 접근성 서비스가 켜져 있어야 동작합니다" />

                </LinearLayout>

                <!-- 카드: 재생 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="재생"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tj_cyan"
                        android:paddingBottom="8dp" />

                    <CheckBox
                        android:id="@+id/chk_start_fullscreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tj_text_primary"
                        android:text="▶ 영상을 전체화면으로 시작 (탭하면 해제)" />

                    <CheckBox
                        android:id="@+id/chk_autoplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/tj_text_primary"
                        android:text="🎤 음성 검색 후 첫 곡 자동 재생" />
                </LinearLayout>
            </LinearLayout>

        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp">

            <!-- ══════════ 오른쪽 컬럼 ══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 카드: 마이크 입력 방식 (독립 — 음성검색·녹음·채점 공통) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="마이크 입력 방식"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tj_cyan"
                        android:paddingBottom="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/tj_text_secondary"
                        android:paddingBottom="8dp"
                        android:text="녹음에 소리가 안 들어가면 '일반 MIC'로 바꿔보세요" />

                    <RadioGroup
                        android:id="@+id/mic_source_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/ms_auto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/tj_text_primary"
                            android:textSize="13sp"
                            android:text="자동" />

                        <RadioButton
                            android:id="@+id/ms_mic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/tj_text_primary"
                            android:textSize="13sp"
                            android:text="일반\nMIC" />

                        <RadioButton
                            android:id="@+id/ms_recognition"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/tj_text_primary"
                            android:textSize="13sp"
                            android:text="음성\n인식" />

                        <RadioButton
                            android:id="@+id/ms_comm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/tj_text_primary"
                            android:textSize="13sp"
                            android:text="통화\n마이크" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/btn_source_check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:text="🎚 소스 진단 (말하면서 레벨 확인)" />

                    <Button
                        android:id="@+id/btn_bcast_diag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:text="📡 버튼 신호 조사 (누른 뒤 여기를 탭)" />

                    <Button
                        android:id="@+id/btn_gboard_setup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:text="⌨️ Gboard 설치·기본키보드 (실험)" />
                </LinearLayout>

                <!-- 카드: 녹음 (통합 — 녹음 켜면 하위 옵션 노출) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎙 녹음"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tj_cyan"
                        android:paddingBottom="8dp" />

                    <CheckBox
                        android:id="@+id/chk_recording"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tj_text_primary"
                        android:text="노래 녹음 저장 (다시듣기용)" />

                    <CheckBox
                        android:id="@+id/chk_scoring"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/tj_text_primary"
                        android:text="노래 채점 사용 (녹음 저장 없이도 가능)" />

                    <LinearLayout
                        android:id="@+id/record_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="12dp"
                            android:textSize="13sp"
                            android:textColor="@color/tj_text_secondary"
                            android:text="녹음 품질 — 낮을수록 용량↓·채점 빠름" />

                        <RadioGroup
                            android:id="@+id/rate_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rate_standard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/tj_text_primary"
                                android:textSize="13sp"
                                android:text="표준\n22kHz" />

                            <RadioButton
                                android:id="@+id/rate_save"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/tj_text_primary"
                                android:textSize="13sp"
                                android:text="절약\n16kHz" />

                            <RadioButton
                                android:id="@+id/rate_min"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/tj_text_primary"
                                android:textSize="13sp"
                                android:text="최소\n11kHz" />
                        </RadioGroup>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔊 녹음 음량 (다시듣기)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tj_cyan"
                            android:paddingTop="16dp"
                            android:paddingBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/voice_gain_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="96dp"
                                android:textSize="13sp"
                                android:textColor="@color/tj_cyan"
                                android:text="목소리 100%" />

                            <SeekBar
                                android:id="@+id/voice_gain_seek"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="450" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/accomp_gain_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="96dp"
                                android:textSize="13sp"
                                android:textColor="@color/tj_cyan"
                                android:text="반주 60%" />

                            <SeekBar
                                android:id="@+id/accomp_gain_seek"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="150" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/tj_text_hint"
                            android:paddingTop="6dp"
                            android:text="목소리가 작으면 목소리↑ 또는 반주↓ · 새 녹음부터 적용" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="녹음 싱크 보정"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tj_cyan"
                            android:paddingTop="16dp"
                            android:paddingBottom="2dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/tj_text_secondary"
                            android:paddingBottom="8dp"
                            android:text="다시듣기에서 목소리가 느리면 왼쪽(−), 빠르면 오른쪽(+)" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/sync_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="76dp"
                                android:textSize="13sp"
                                android:textColor="@color/tj_cyan"
                                android:text="0 ms" />

                            <SeekBar
                                android:id="@+id/sync_seek"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="600" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="녹음 저장 위치"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tj_cyan"
                            android:paddingTop="16dp"
                            android:paddingBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/storage_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/st_internal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tj_text_primary"
                                android:text="차 내부 저장소" />

                            <RadioButton
                                android:id="@+id/st_sd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tj_text_primary"
                                android:text="SD카드" />
                        </RadioGroup>

                        <TextView
                            android:id="@+id/storage_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/tj_text_secondary"
                            android:fontFamily="monospace"
                            android:text="용량 확인 중…" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="8dp">

                            <Button
                                android:id="@+id/btn_clear_internal"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:text="🗑 차 내부 전체 삭제" />

                            <Button
                                android:id="@+id/btn_clear_sd"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="12sp"
                                android:text="🗑 SD카드 전체 삭제" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tj_text_primary"
                                android:text="최대 용량(MB):" />

                            <EditText
                                android:id="@+id/max_storage_input"
                                android:layout_width="90dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:inputType="number"
                                android:importantForAutofill="no" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="2dp"
                            android:textSize="11sp"
                            android:textColor="@color/tj_text_hint"
                            android:text="이 용량을 넘으면 오래된 녹음부터 자동으로 지웁니다." />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include android:id="@+id/navbar" layout="@layout/include_navbar" />
</LinearLayout>
