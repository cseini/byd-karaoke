<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tj_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ 설정"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/tj_pink"
        android:shadowColor="@color/tj_pink_dark"
        android:shadowRadius="12" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/divider_gradient" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="음성 검색"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="4dp"
                android:text="키를 넣으면 검색 화면에 🎤 음성 버튼이 나타납니다. aistudio.google.com 에서 무료 발급." />

            <EditText
                android:id="@+id/openai_key_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Gemini API 키 (무료)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <RadioGroup
                android:id="@+id/gemini_model_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/gm_flash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="정확 (flash · 250회/일)" />

                <RadioButton
                    android:id="@+id/gm_lite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="한도↑ (flash-lite · 1000회/일)" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다시듣기 싱크 보정"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="6dp"
                android:text="다시듣기에서 목소리가 느리면 왼쪽(−), 빠르면 오른쪽(+)으로. 조정 후 새로 녹음하면 적용됩니다." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/sync_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="90dp"
                    android:textSize="13sp"
                    android:textColor="@color/tj_cyan"
                    android:text="0 ms" />

                <SeekBar
                    android:id="@+id/sync_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="600" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="녹음 품질"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="6dp"
                android:text="낮을수록 용량이 줄고 채점이 빨라집니다(반주 음질은 조금 낮아짐)." />

            <RadioGroup
                android:id="@+id/rate_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rate_standard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="표준\n22kHz" />

                <RadioButton
                    android:id="@+id/rate_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="절약\n16kHz" />

                <RadioButton
                    android:id="@+id/rate_min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="최소\n11kHz" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/chk_scoring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/tj_text_primary"
                android:text="노래 채점 사용 (끄면 즉시 저장 · 완곡도 빠름)" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="녹음 저장 위치"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <RadioGroup
                android:id="@+id/storage_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/st_internal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="차 내부 저장소" />

                <RadioButton
                    android:id="@+id/st_sd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="SD카드" />
            </RadioGroup>

            <TextView
                android:id="@+id/storage_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:fontFamily="monospace"
                android:text="용량 확인 중…" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="최대 사용 용량(MB):" />

                <EditText
                    android:id="@+id/max_storage_input"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:inputType="number"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/tj_text_hint"
                android:text="이 용량을 넘으면 오래된 녹음부터 자동으로 지웁니다." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="앱 업데이트"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="8dp"
                android:text="현재 버전 확인 중…" />

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/tj_green"
                android:textColor="@color/tj_bg_deep"
                android:text="🔄 업데이트 확인" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="저장" />

    <include layout="@layout/include_navbar" />
</LinearLayout>
