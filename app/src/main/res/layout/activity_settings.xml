<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tj_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️ 설정"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tj_pink"
            android:shadowColor="@color/tj_pink_dark"
            android:shadowRadius="12" />

        <Button
            android:id="@+id/btn_back"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닫기" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/divider_gradient" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="음성 검색"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="4dp"
                android:text="키를 넣으면 🎤 음성 검색이 켜집니다. aistudio.google.com 무료 발급.\n키를 여러 개 넣으면 한도 초과 시 자동으로 다음 키를 씁니다." />

            <EditText
                android:id="@+id/openai_key_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Gemini API 키 1 (무료)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/openai_key_input2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="Gemini API 키 2 (선택 · 예비)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/openai_key_input3"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="Gemini API 키 3 (선택 · 예비)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btn_key_qr"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📱 폰으로 키 입력 (QR)" />

            <RadioGroup
                android:id="@+id/gemini_model_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/gm_flash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="정확 (flash 계열)" />

                <RadioButton
                    android:id="@+id/gm_lite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="한도↑ (flash-lite 계열)" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="녹음 싱크 보정"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="6dp"
                android:text="목소리가 느리면 왼쪽(−), 빠르면 오른쪽(+). 새로 녹음할 때 적용." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/sync_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="90dp"
                    android:textSize="13sp"
                    android:textColor="@color/tj_cyan"
                    android:text="0 ms" />

                <SeekBar
                    android:id="@+id/sync_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="600" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="마이크 입력 방식"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="6dp"
                android:text="소리가 안 들어가면 '일반(MIC)'으로 바꿔보세요(유닛에 따라 다름). 기본은 자동." />

            <RadioGroup
                android:id="@+id/mic_source_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/ms_auto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="자동" />

                <RadioButton
                    android:id="@+id/ms_mic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="일반\nMIC" />

                <RadioButton
                    android:id="@+id/ms_recognition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="음성\n인식" />

                <RadioButton
                    android:id="@+id/ms_comm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="통화\n마이크" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/chk_mic_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/tj_text_primary"
                android:text="🎙 USB 마이크 버튼으로 제어" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/tj_text_hint"
                android:paddingStart="8dp"
                android:text="마이크만으로 조작할 수 있어요.\n· 마이크 버튼 — 짧게: 노래방 패널 / 길게: 음성 검색\n· 볼륨▲ — 짧게: 마이크 볼륨↑ / 길게: 다음 예약곡\n· 볼륨▼ — 짧게: 마이크 볼륨↓ / 길게: 노래 종료(채점)\n켜면 USB 권한 허용창이 뜹니다.\n⚠️ 마이크 기종마다 버튼 신호가 달라서, 켰는데 버튼이 안 되거나 오히려 기본 버튼(볼륨·에코)이 안 먹으면 이 옵션을 끄세요." />

            <CheckBox
                android:id="@+id/chk_wheel_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/tj_text_primary"
                android:visibility="gone"
                android:text="🎚 휠 무음 버튼 더블클릭으로 음성검색" />

            <!-- 휠 버튼: 접근성 서비스를 켜야 하는데 앱이 자동으로 못 켜고(WRITE_SECURE_SETTINGS 는
                 시스템 앱 전용) 일반 사용자는 adb 를 써야 해서 UI 에서 숨김.
                 기능·코드는 유지 — 이미 접근성을 켠 기기에서는 설정값이 켜져 있으면 그대로 동작한다. -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="녹음 품질"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="6dp"
                android:text="낮을수록 용량이 줄고 채점이 빨라집니다(반주 음질은 조금 낮아짐)." />

            <RadioGroup
                android:id="@+id/rate_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rate_standard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="표준\n22kHz" />

                <RadioButton
                    android:id="@+id/rate_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="절약\n16kHz" />

                <RadioButton
                    android:id="@+id/rate_min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tj_text_primary"
                    android:textSize="13sp"
                    android:text="최소\n11kHz" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="녹음 음량 (다시듣기)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="6dp"
                android:text="다시듣기에서 내 목소리가 작으면 목소리를 올리거나 반주를 내리세요. 새로 녹음할 때 적용." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/voice_gain_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:textSize="13sp"
                    android:textColor="@color/tj_cyan"
                    android:text="목소리 100%" />

                <SeekBar
                    android:id="@+id/voice_gain_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="450" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/accomp_gain_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:textSize="13sp"
                    android:textColor="@color/tj_cyan"
                    android:text="반주 60%" />

                <SeekBar
                    android:id="@+id/accomp_gain_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="150" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/chk_recording"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/tj_text_primary"
                android:text="노래 녹음 사용 (끄면 녹음·채점 없이 재생만)" />

            <CheckBox
                android:id="@+id/chk_scoring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/tj_text_primary"
                android:text="노래 채점 사용 (끄면 즉시 저장 · 완곡도 빠름)" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="녹음 저장 위치"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <RadioGroup
                android:id="@+id/storage_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/st_internal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="차 내부 저장소" />

                <RadioButton
                    android:id="@+id/st_sd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="SD카드" />
            </RadioGroup>

            <TextView
                android:id="@+id/storage_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="12sp"
                android:textColor="@color/tj_text_secondary"
                android:fontFamily="monospace"
                android:text="용량 확인 중…" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tj_text_primary"
                    android:text="최대 사용 용량(MB):" />

                <EditText
                    android:id="@+id/max_storage_input"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:inputType="number"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/tj_text_hint"
                android:text="이 용량을 넘으면 오래된 녹음부터 자동으로 지웁니다." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/tj_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="앱 업데이트"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tj_cyan"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/tj_text_secondary"
                android:paddingBottom="8dp"
                android:text="현재 버전 확인 중…" />

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/tj_green"
                android:textColor="@color/tj_bg_deep"
                android:text="🔄 업데이트 확인" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="저장" />

    <include android:id="@+id/navbar" layout="@layout/include_navbar" />
</LinearLayout>
