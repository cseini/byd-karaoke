<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/glass_card"
    app:strokeColor="@color/tj_pink"
    app:strokeWidth="1.5dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/tile_thumb"
            android:layout_width="match_parent"
            android:layout_height="122dp"
            android:scaleType="centerCrop"
            android:background="@color/tj_panel_light"
            android:contentDescription="노래" />

        <TextView
            android:id="@+id/tile_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_score_pill"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/tj_bg_deep" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
