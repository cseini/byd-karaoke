<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ===== Phase 0-A: 유튜브 렌더 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="① 유튜브 렌더 검증 (0-A)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtube_player_view"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/player_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="플레이어 상태: 대기"
            android:textSize="13sp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/video_id_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="유튜브 videoId (11자리) 또는 전체 URL"
            android:text="dQw4w9WgXcQ"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_load_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="영상 로드" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#33888888" />

        <!-- ===== Phase 0-B: 마이크 채점 성립 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="② 마이크 채점 성립 검증 (0-B)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="녹음 소스 선택 (여러 소스로 각각 녹음해 비교):"
            android:textSize="13sp"
            android:paddingTop="4dp" />

        <RadioGroup
            android:id="@+id/source_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/src_unprocessed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNPROCESSED (raw, 지원 시 최선)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/src_voice_recognition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOICE_RECOGNITION (AGC/NS 없음)" />

            <RadioButton
                android:id="@+id/src_voice_communication"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOICE_COMMUNICATION (통화, AEC 경로)" />

            <RadioButton
                android:id="@+id/src_mic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIC (기본)" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/chk_aec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AcousticEchoCanceler 적용 (스피커 반주 취소 실험)" />

        <CheckBox
            android:id="@+id/chk_prefer_usb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USB 마이크로 강제 라우팅 (setPreferredDevice)"
            android:checked="true" />

        <Button
            android:id="@+id/btn_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="● 녹음 시작" />

        <TextView
            android:id="@+id/rec_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="녹음 상태: 대기"
            android:textSize="13sp"
            android:paddingTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#33888888" />

        <!-- ===== 환경 정보 (0-A 위험도 판정) ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="③ 환경 정보"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btn_refresh_env"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="환경/입력장치 새로고침" />

        <TextView
            android:id="@+id/env_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingTop="6dp"
            android:text="(새로고침을 누르세요)" />

    </LinearLayout>
</ScrollView>
