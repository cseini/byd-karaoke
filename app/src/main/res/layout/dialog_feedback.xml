<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/tj_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💬 의견 보내기"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/tj_cyan" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/fb_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/fb_cat_bug"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="버그" />

        <com.google.android.material.chip.Chip
            android:id="@+id/fb_cat_error"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오류" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="건의" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="기타" />
    </com.google.android.material.chip.ChipGroup>

    <EditText
        android:id="@+id/fb_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minLines="4"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:hint="무슨 일이 있었는지 적어주세요. 어떤 화면에서, 무엇을 눌렀을 때 그랬는지 알려주시면 찾기 쉽습니다."
        android:textColor="@color/tj_text_primary"
        android:textColorHint="@color/tj_text_secondary"
        android:textSize="15sp"
        android:importantForAutofill="no" />

    <CheckBox
        android:id="@+id/fb_with_log"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:textColor="@color/tj_text_secondary"
        android:text="진단 기록(이벤트 로그) 함께 보내기" />

    <TextView
        android:id="@+id/fb_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:textColor="@color/tj_text_secondary" />

</LinearLayout>
</ScrollView>
